# Configuración local sintética. Nunca reemplaces estos valores por secretos reales en Git.
POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=cdrl_dev_only
POSTGRES_PORT=5432
DYNAMODB_PORT=8000
AWS_REGION=us-east-1

# M03 - Contraseñas sintéticas por rol.
MIGRATION_ROLE_PASSWORD=migration_pw_dev
WRITER_ROLE_PASSWORD=writer_pw_dev
READER_ROLE_PASSWORD=reader_pw_dev
OPERATOR_ROLE_PASSWORD=operator_pw_dev

# M04/M05 - Conexión local a MongoDB.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_pw_dev
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=cdrl_events
MONGO_URI=mongodb://root:root_pw_dev@localhost:27017/cdrl_events?authSource=admin

# M09 - Usuarios de prueba para seguridad
MONGO_READER_USER=m09_reader
MONGO_READER_PASSWORD=reader_pw_dev
MONGO_WRITER_USER=m09_writer
MONGO_WRITER_PASSWORD=writer_pw_dev
MONGO_VULN_USER=m09_vuln
MONGO_VULN_PASSWORD=vuln_pw_dev
